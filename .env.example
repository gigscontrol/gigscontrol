# ============================================================
# flow.book — Variáveis de ambiente
# ============================================================
# Copie este arquivo para `.env.local` e preencha com os valores
# reais do seu projeto Supabase. O `.env.local` NÃO vai para o Git.
#
# Onde encontrar: Supabase → Project Settings → API
# ============================================================

# URL base do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publishable / anon (pública — pode ficar no frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# Chave secreta / service_role (NUNCA exponha — só no servidor)
# Usada apenas por código de backend (Route Handlers).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx
