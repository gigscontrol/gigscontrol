# ============================================================
# GIGS CONTROL — Variáveis de ambiente
# ============================================================
# Copie este arquivo para `.env.local` e preencha com os valores
# reais do seu projeto Supabase. O `.env.local` NÃO vai para o Git.
#
# Onde encontrar: Supabase → Project Settings → API
# ============================================================

# URL base do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publishable / anon (pública — pode ficar no frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# Chave secreta / service_role (NUNCA exponha — só no servidor)
# Usada apenas por código de backend (Route Handlers).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx

# ============================================================
# Stripe — Assinaturas recorrentes (Subscriptions)
# ============================================================
# Onde encontrar: dashboard.stripe.com → Developers → API keys
# (use as chaves de TESTE primeiro; troque pelas de produção no go-live).
# Configure um Price por plano+ciclo com lookup_key = `${plano}_${ciclo}`
# (ex.: equipe_mensal, agencia-plus_anual).

# Secret Key (SECRETA — só servidor). Cria a Checkout Session e consulta
# assinaturas/invoices. Começa com sk_test_ (teste) / sk_live_ (produção).
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Segredo de assinatura do webhook (signing secret). Mostrado ao criar o
# endpoint do webhook em Developers → Webhooks. Começa com whsec_.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# URL pública do app — usada nas success_url/cancel_url do checkout.
# Dev: http://localhost:3000  •  Prod: https://gigscontrol.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Google Calendar — sync de shows por artista (OAuth 2.0)
# ============================================================
# Onde encontrar: Google Cloud Console → APIs & Services → Credentials →
# "Create Credentials" → OAuth client ID → tipo "Web application".
# Ative a "Google Calendar API" e configure a OAuth consent screen.
# Redirect URIs autorizadas (cadastre as duas):
#   http://localhost:3000/api/google/callback
#   https://gigscontrol.com/api/google/callback

# Client ID (usado só no servidor)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Client Secret (SECRETO — só servidor)
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Chave de 32 bytes (base64) pra criptografar os refresh tokens em repouso.
# Gere uma com:  openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=

# ============================================================
# Integrações de voo / cidade / selfie (opcionais por feature)
# ============================================================
# Sem estas, as features correspondentes falham em runtime.

# Import de voucher de voo por IA (POST /api/voos/importar) — console.anthropic.com
ANTHROPIC_API_KEY=

# Lookup de voo por número (GET /api/voos/lookup) — aviationstack.com
AVIATIONSTACK_API_KEY=

# Autocomplete de cidade global (GET /api/cidades-mundo) — geonames.org (username)
GEONAMES_USERNAME=

# Reconhecimento facial da assinatura (selfie ao vivo) — AWS Rekognition (IAM)
REKOGNITION_KEY_ID=
REKOGNITION_KEY_SECRET=
REKOGNITION_REGION=us-east-1

# ============================================================
# Cron de manutenção (Vercel Cron)
# ============================================================
# Protege a rota GET /api/cron/limpar-storage, que apaga os objetos de Storage
# órfãos após o purge da lixeira (comprovante/voucher/assinatura). A Vercel injeta
# `Authorization: Bearer $CRON_SECRET` nas chamadas agendadas (vercel.json).
# Gere um valor forte com:  openssl rand -hex 32
CRON_SECRET=

# ============================================================
# Sentry — monitoramento de erros em produção
# ============================================================
# DSN do projeto (sentry.io → Project Settings → Client Keys/DSN). NÃO é segredo
# (é chave pública). SEM ele, o Sentry fica DESLIGADO — nada quebra.
NEXT_PUBLIC_SENTRY_DSN=
# Org + projeto (pra subir source maps no build). Opcionais.
SENTRY_ORG=
SENTRY_PROJECT=
# Token de upload de source maps (SECRETO — só no build da Vercel). Sem ele o
# Sentry funciona, mas os stack traces ficam minificados.
SENTRY_AUTH_TOKEN=
